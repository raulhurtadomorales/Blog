const pendiente = { video: 'Video pendiente', imagen: 'Imagen pendiente', audio: 'Audio pendiente' };

// true: las piezas sin "src" no se muestran (y un grupo sin piezas tampoco). Así la página se ve completa aunque falte material.
// false: se ven las cajas "pendiente", útil mientras llenas.
const ocultarVacios = true;
const visibles = (piezas) => (ocultarVacios ? piezas.filter((p) => p.src) : piezas);
---

<BaseLayout
  title="Raúl Hurtado · Selección de trabajo"
  description="Selección de trabajo de Raúl Hurtado."
  canonicalPath="/portafolio-studio/"
  noindex={true}
>
  <main class="pf">
    <header class="intro">
      <div class="col">
        <h1 class="fade d1">Raúl Hurtado</h1>
        <p class="tesis fade d2">Construyo estudios de contenido que operan con estándar de agencia y con lo único que una agencia nunca tiene: el contexto del negocio.</p>
        <p class="contexto fade d3">Dieciséis años entre agencia creativa y lado cliente. Hoy dirijo marca, medios, creatividad y producción de un portafolio de cinco marcas de consumo. Estos cinco casos no son lo más bonito que he hecho. Son lo que mejor explica cómo trabajo.</p>
      </div>
      <nav class="indice fade d4" aria-label="Casos">
        {casos.map((c, i) => (
          <a href={`#${c.id}`}>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <span class="arg">{c.porque}</span>
          </a>
        ))}
      </nav>
    </header>

    {casos.map((c, i) => (
      <section class="caso" id={c.id}>
        <header class="cabeza col">
          <p class="num-caso">{String(i + 1).padStart(2, '0')}</p>
          <h2>{c.porque}</h2>
          <p class="etiqueta">{c.etiqueta}</p>
          <p class="nombre-campana">{c.titulo}</p>
          {c.bajada.map((t) => <p class="bajada">{t}</p>)}
        </header>

        {c.grupos.map((g, gi) => (
          <Fragment>
            {visibles(g.piezas).length > 0 && (
              <div class={`grupo${g.principal ? ' es-principal' : ''}`}>
                {(g.nombre || g.nota) && (
                  <div class="grupo-cabeza col">
                    {g.nombre && <h3>{g.nombre}</h3>}
                    {g.nota && <p class="nota">{g.nota}</p>}
                  </div>
                )}
                <div class={`rejilla ${g.formato}`}>
                  {visibles(g.piezas).map((pz) => (
                    <figure class={`pieza${pz.destacada ? ' destacada' : ''}`}>
                      {pz.tipo === 'video' && pz.src && (
                        <div class={`marco ${g.formato}`}>
                          <iframe src={pz.src} title={pz.pie || c.titulo} loading="lazy" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
                        </div>
                      )}
                      {pz.tipo === 'imagen' && pz.src && <img src={pz.src} alt={pz.pie || c.titulo} loading="lazy" />}
                      {pz.tipo === 'audio' && pz.src && <audio controls preload="none" src={pz.src}></audio>}
                      {!pz.src && <div class={`marco ${g.formato} vacio`}><span>{pendiente[pz.tipo]}</span></div>}
                      {pz.pie && <figcaption>{pz.pie}</figcaption>}
                    </figure>
                  ))}
                </div>
              </div>
            )}
            {gi === 0 && (
              <dl class="ficha">
                <dt>El problema</dt><dd>{c.problema}</dd>
                <dt>Mi rol</dt><dd>{c.rol}</dd>
                {c.resultado && <Fragment><dt>El resultado</dt><dd class="resultado">{c.resultado}</dd></Fragment>}
              </dl>
            )}
          </Fragment>
        ))}
      </section>
    ))}

    <footer class="cierre col">
      <p>Birdman quiere operar como la mejor agencia de México, desde adentro del negocio. Eso es lo que he estado construyendo estos años, aunque sin ese nombre.</p>
      <p class="enlaces">Más trabajo en <a href="https://www.behance.net/raulhurtado" target="_blank" rel="noopener noreferrer">Behance</a>. Trayectoria completa en <a href="https://www.linkedin.com/in/rahurtado/" target="_blank" rel="noopener noreferrer">LinkedIn</a>.</p>
    </footer>

    <div class="site-footer">
      <span>© 2026 Raúl Hurtado</span>
      <span>raulhurtadomorales.com</span>
    </div>
  </main>
</BaseLayout>

<style>
  /* Tokens, fondo y grano vienen de global.css vía BaseLayout.
     Regla de composición: el texto vive en una columna angosta (.col) y
     el material visual usa todo el ancho. Ese contraste es el ritmo de la página. */

  .pf {
    position: relative;
    z-index: 2;
    max-width: 1180px;
    margin: 0 auto;
    padding: 6rem 3.5rem 4rem;
    color: var(--petroleo);
  }
  .col { max-width: 44rem; }

  /* — Intro — */
  .intro { position: relative; margin-bottom: 7rem; }
  .intro::before {
    content: '';
    position: absolute;
    inset: -40% 0 20% 0;
    background: radial-gradient(ellipse 70% 55% at 25% 30%, rgba(214, 178, 126, 0.3), transparent 68%);
    z-index: -1;
    pointer-events: none;
  }
  h1 {
    font-family: var(--display);
    font-variation-settings: 'SOFT' 30, 'WONK' 1, 'opsz' 144;
    font-weight: 400;
    font-size: clamp(3.5rem, 10vw, 7.5rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
    margin-bottom: 2rem;
  }
  .tesis {
    font-family: var(--display);
    font-variation-settings: 'SOFT' 40, 'opsz' 72;
    font-style: italic;
    font-size: clamp(1.35rem, 2.6vw, 1.8rem);
    line-height: 1.25;
    letter-spacing: -0.015em;
    margin-bottom: 1.5rem;
  }
  .contexto { font-size: 1.08rem; line-height: 1.65; color: var(--petroleo-80); }

  /* Índice: los cinco argumentos, con peso de lectura */
  .indice {
    margin-top: 3.5rem;
    border-top: 1px solid var(--petroleo-12);
  }
  .indice a {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 1.5rem;
    align-items: baseline;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--petroleo-12);
    text-decoration: none;
    color: var(--petroleo);
    transition: padding-left 0.3s ease, color 0.3s ease;
  }
  .indice a:hover,
  .indice a:focus-visible { padding-left: 0.6rem; }
  .indice .num {
    font-family: var(--display);
    font-size: 0.95rem;
    color: var(--camel);
    letter-spacing: 0.1em;
  }
  .indice .arg {
    font-family: var(--display);
    font-variation-settings: 'SOFT' 35, 'opsz' 72;
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    line-height: 1.25;
    letter-spacing: -0.015em;
  }
  .indice a:hover .arg { color: var(--camel); }

  /* — Caso — */
  .caso {
    padding-top: 6rem;
    margin-top: 6rem;
    border-top: 1px solid var(--petroleo-12);
    scroll-margin-top: 1.5rem;
  }
  .cabeza { margin-bottom: 3.5rem; }
  .num-caso {
    font-family: var(--display);
    font-size: 1rem;
    letter-spacing: 0.12em;
    color: var(--camel);
    margin-bottom: 1.25rem;
  }
  /* El argumento es lo primero que se lee de cada caso */
  .cabeza h2 {
    font-family: var(--display);
    font-variation-settings: 'SOFT' 35, 'opsz' 144;
    font-weight: 400;
    font-size: clamp(2rem, 4.6vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: 2rem;
    max-width: 20ch;
  }
  .etiqueta {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--petroleo-55);
  }
  .nombre-campana {
    font-family: var(--display);
    font-variation-settings: 'SOFT' 40, 'opsz' 72;
    font-style: italic;
    font-size: clamp(1.3rem, 2.2vw, 1.65rem);
    line-height: 1.2;
    margin: 0.35rem 0 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--petroleo-12);
  }
  .bajada {
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--petroleo-80);
  }
  .bajada + .bajada { margin-top: 1.1rem; }

  /* — Grupos de material — */
  .grupo { margin-bottom: 4rem; }
  .es-principal { margin-bottom: 3rem; }
  .grupo-cabeza { margin-bottom: 1.25rem; }
  .grupo-cabeza h3 {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--petroleo-55);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--petroleo-12);
    margin-bottom: 0.9rem;
  }
  .nota { color: var(--petroleo-65); line-height: 1.6; }

  /* Rejillas con columnas fijas: el material se lee como serie, no como relleno */
  .rejilla { display: grid; gap: 1.5rem; align-items: start; }
  .rejilla.horizontal { grid-template-columns: repeat(2, 1fr); }
  .rejilla.vertical { grid-template-columns: repeat(4, 1fr); }
  .rejilla.cuadrado { grid-template-columns: repeat(3, 1fr); }
  .rejilla.audio { grid-template-columns: 1fr; max-width: 40rem; gap: 1rem; }
  .es-principal .rejilla { grid-template-columns: 1fr; }
  .es-principal .marco.vertical { max-width: 24rem; }
  .es-principal .marco.cuadrado { max-width: 38rem; }

  .pieza { margin: 0; }
  .pieza.destacada { grid-column: 1 / -1; }
