const pendiente = { video: 'Video pendiente', imagen: 'Imagen pendiente', audio: 'Audio pendiente' };

// true: las piezas sin "src" no se muestran (y un grupo sin piezas tampoco). Así la página se ve completa aunque falte material.
// false: se ven las cajas "pendiente", útil mientras llenas.
const ocultarVacios = true;
const visibles = (piezas) => (ocultarVacios ? piezas.filter((p) => p.src) : piezas);
---

<BaseLayout
  title="Raúl Hurtado · Selección de trabajo"
  description="Selección de trabajo de Raúl Hurtado."
  canonicalPath="/portafolio-studio/"
  noindex={true}
>
  <main class="pf">
    <header class="intro">
      <h1 class="fade d1">Raúl Hurtado</h1>
      <p class="tesis fade d2">Construyo estudios de contenido que operan con estándar de agencia y con lo único que una agencia nunca tiene: el contexto del negocio.</p>
      <p class="contexto fade d3">Dieciséis años entre agencia creativa y lado cliente. Hoy dirijo marca, medios, creatividad y producción de un portafolio de cinco marcas de consumo. Estos cinco casos no son lo más bonito que he hecho. Son lo que mejor explica cómo trabajo.</p>
      <nav class="indice fade d4" aria-label="Casos">
        <ol>
          {casos.map((c) => <li><a href={`#${c.id}`}>{c.porque}</a></li>)}
        </ol>
      </nav>
    </header>

    {casos.map((c) => (
      <section class="caso" id={c.id}>
        <p class="etiqueta">{c.etiqueta}</p>
        <p class="porque">{c.porque}</p>
        <h2>{c.titulo}</h2>
        <p class="bajada">{c.bajada}</p>

        {c.grupos.map((g, gi) => (
          <Fragment>
            {visibles(g.piezas).length > 0 && (
            <div class={`grupo${g.principal ? ' es-principal' : ''}`}>
              {g.nombre && <h3>{g.nombre}</h3>}
              {g.nota && <p class="nota">{g.nota}</p>}
              <div class={`rejilla ${g.formato}`}>
                {visibles(g.piezas).map((p) => (
                  <figure class="pieza">
                    {p.tipo === 'video' && p.src && (
                      <div class={`marco ${g.formato}`}>
                        <iframe src={p.src} title={p.pie || c.titulo} loading="lazy" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
                      </div>
                    )}
                    {p.tipo === 'imagen' && p.src && <img src={p.src} alt={p.pie || c.titulo} loading="lazy" />}
                    {p.tipo === 'audio' && p.src && <audio controls preload="none" src={p.src}></audio>}
                    {!p.src && <div class={`marco ${g.formato} vacio`}><span>{pendiente[p.tipo]}</span></div>}
                    {p.pie && <figcaption>{p.pie}</figcaption>}
                  </figure>
                ))}
              </div>
            </div>
            )}
            {gi === 0 && (
              <dl class="ficha">
                <dt>El problema</dt><dd>{c.problema}</dd>
                <dt>Mi rol</dt><dd>{c.rol}</dd>
                {c.resultado && <Fragment><dt>El resultado</dt><dd class="resultado">{c.resultado}</dd></Fragment>}
              </dl>
            )}
          </Fragment>
        ))}
      </section>
    ))}

    <footer class="cierre">
      <p>Birdman quiere operar como la mejor agencia de México, desde adentro del negocio. Eso es lo que he estado construyendo estos años, aunque sin ese nombre.</p>
      <p class="enlaces">Más trabajo en <a href="https://www.behance.net/raulhurtado" target="_blank" rel="noopener noreferrer">Behance</a>. Trayectoria completa en <a href="https://www.linkedin.com/in/rahurtado/" target="_blank" rel="noopener noreferrer">LinkedIn</a>.</p>
    </footer>

    <div class="site-footer">
      <span>© 2026 Raúl Hurtado</span>
      <span>raulhurtadomorales.com</span>
    </div>
  </main>
</BaseLayout>

<style>
  /* Tokens y fondo vienen de src/styles/global.css (vía BaseLayout).
     Aquí solo lo propio de esta página, con el mismo tratamiento tipográfico del sitio. */

  .pf {
    position: relative;
    z-index: 2; /* por encima del grano del sitio */
    max-width: 1100px;
    margin: 0 auto;
    padding: 5rem 3.5rem 4rem;
    color: var(--petroleo);
  }

  /* — Intro (mismo lenguaje que el hero del home) — */
  .intro {
    position: relative;
    max-width: 46rem;
    margin-bottom: 5rem;
  }
  .intro::before {
    content: '';
    position: absolute;
    inset: -30% -25% -10% -25%;
    background: radial-gradient(ellipse 60% 50% at 30% 30%, rgba(214, 178, 126, 0.28), transparent 65%);
    z-index: -1;
    pointer-events: none;
  }
  h1 {
    font-family: var(--display);
    font-variation-settings: 'SOFT' 30, 'WONK' 1, 'opsz' 144;
    font-weight: 400;
    font-size: clamp(3.5rem, 10vw, 7.5rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
    margin-bottom: 2rem;
  }
  .tesis {
    font-family: var(--display);
    font-variation-settings: 'SOFT' 40, 'opsz' 72;
    font-weight: 400;
    font-style: italic;
    font-size: clamp(1.35rem, 2.6vw, 1.8rem);
    line-height: 1.25;
    letter-spacing: -0.015em;
    margin-bottom: 1.5rem;
  }
  .contexto {
    font-size: clamp(1.02rem, 1.2vw, 1.12rem);
    line-height: 1.65;
    color: var(--petroleo-80);
    margin-bottom: 2.75rem;
  }

  .indice ol {
    padding-left: 1.25rem;
    line-height: 2.1;
    color: var(--petroleo-55);
  }
  .indice li::marker {
    font-size: 0.85rem;
  }

  /* — Links tipo marcador, como en el resto del sitio — */
  .indice a,
  .cierre a {
    color: var(--petroleo);
    text-decoration: none;
    font-weight: 500;
    background-image: linear-gradient(transparent 68%, var(--camel-soft) 68%);
    padding: 0 2px;
    transition: background-image 0.35s ease;
  }
  .indice a:hover,
  .indice a:focus-visible,
  .cierre a:hover,
  .cierre a:focus-visible {
    background-image: linear-gradient(transparent 0%, var(--camel-soft) 0%);
  }

  /* — Casos — */
  .caso {
    padding-top: 4rem;
    margin-top: 4rem;
    border-top: 1px solid var(--petroleo-12);
    scroll-margin-top: 1.5rem;
  }
  .etiqueta {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--petroleo-55);
    margin-bottom: 1rem;
  }
  .porque {
    font-weight: 600;
    color: var(--petroleo);
    margin-bottom: 1rem;
    padding-left: 0.9rem;
    border-left: 3px solid var(--camel);
  }
  h2 {
    font-family: var(--display);
    font-variation-settings: 'SOFT' 35, 'opsz' 144;
    font-weight: 400;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin-bottom: 1.25rem;
  }
  .bajada {
    font-size: clamp(1.05rem, 1.3vw, 1.15rem);
    line-height: 1.65;
    color: var(--petroleo-80);
    max-width: 44rem;
    margin-bottom: 2.5rem;
  }

  .grupo {
    margin-bottom: 2.5rem;
  }
  h3 {
    font-family: var(--display);
    font-variation-settings: 'SOFT' 35, 'opsz' 72;
    font-weight: 500;
    font-size: 1.3rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin-bottom: 0.35rem;
  }
  .nota {
    color: var(--petroleo-65);
    max-width: 40rem;
    line-height: 1.55;
    margin-bottom: 1rem;
  }

  /* — Rejillas y piezas (estructura original) — */
  .rejilla { display: grid; gap: 1rem; align-items: start; }
  .rejilla.horizontal { grid-template-columns: repeat(auto-fill, minmax(min(24rem, 100%), 1fr)); }
  .rejilla.vertical { grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr)); }
  .rejilla.cuadrado { grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); }
  .rejilla.audio { grid-template-columns: 1fr; max-width: 36rem; }
  .es-principal .rejilla { grid-template-columns: 1fr; }
  .es-principal .marco.vertical { max-width: 22rem; }
  .es-principal .marco.cuadrado { max-width: 34rem; }

  .pieza { margin: 0; }
  .marco { position: relative; width: 100%; background: var(--petroleo); border-radius: 2px; overflow: hidden; }
  .marco.horizontal { aspect-ratio: 16 / 9; }
  .marco.vertical { aspect-ratio: 9 / 16; }
  .marco.cuadrado { aspect-ratio: 1 / 1; }
  .marco.audio { height: 3.25rem; }
  .marco iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .marco.vacio {
    background: rgba(27, 46, 42, 0.06);
    border: 1px dashed rgba(27, 46, 42, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .marco.vacio span { color: var(--petroleo-55); font-size: 0.85rem; }
  .pieza img { display: block; width: 100%; height: auto; border-radius: 2px; }
  .pieza audio { width: 100%; }
  figcaption {
    color: var(--petroleo-65);
    font-size: 0.92rem;
    line-height: 1.5;
    margin-top: 0.6rem;
  }

  /* — Ficha: mismo split label/cuerpo de las rows del home — */
  .ficha {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 1rem 4rem;
    max-width: 56rem;
    margin: 0 0 3rem;
    padding: 2rem 0;
    border-top: 1px solid var(--petroleo-12);
    border-bottom: 1px solid var(--petroleo-12);
  }
  .ficha dt {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--petroleo-35, rgba(27, 46, 42, 0.35));
    padding-top: 0.3rem;
  }
  .ficha dd {
    margin: 0;
    line-height: 1.65;
    color: var(--petroleo-80);
  }
  .ficha .resultado {
    font-family: var(--display);
    font-variation-settings: 'SOFT' 35, 'opsz' 72;
    font-size: 1.2rem;
    line-height: 1.45;
    color: var(--petroleo);
  }

  /* — Cierre — */
  .cierre {
    margin-top: 5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--petroleo-12);
    max-width: 46rem;
  }
  .cierre p {
    font-family: var(--display);
    font-variation-settings: 'SOFT' 40, 'opsz' 72;
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    line-height: 1.4;
    margin-bottom: 1.25rem;
  }
  .cierre .enlaces {
    font-family: var(--sans);
    font-size: 1rem;
    color: var(--petroleo-65);
  }

  /* — Footer común del sitio — */
  .site-footer {
    margin-top: 5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--petroleo-12);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--petroleo-55);
  }

  @media (max-width: 860px) {
    .pf { padding: 3rem 2rem 3rem; }
    .ficha { grid-template-columns: 1fr; gap: 0.3rem; }
    .ficha dd { margin-bottom: 1rem; }
  }
  @media (max-width: 480px) {
    .pf { padding: 2.5rem 1.5rem 2.5rem; }
    .site-footer { flex-direction: column; gap: 0.4rem; }
  }
</style>
