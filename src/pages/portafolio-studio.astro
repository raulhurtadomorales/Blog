      ]},
      { nombre: 'Formatos verticales', formato: 'vertical', nota: 'El beneficio del producto en dos segundos.', piezas: [
        { tipo: 'video', src: 'https://www.youtube-nocookie.com/embed/SPsA0mcDv1U', pie: 'Video vertical' },
        { tipo: 'video', src: 'https://www.youtube-nocookie.com/embed/7X9WS0tN7LE', pie: 'Video promocional' },
        { tipo: 'imagen', src: '/portafolio/mac/gif-producto.gif', pie: 'GIF de producto' },
      ]},
      { nombre: 'Imágenes de campaña', formato: 'cuadrado', nota: 'Adaptaciones por formato, sin perder el código visual de la marca.', piezas: [
        { tipo: 'imagen', src: '/portafolio/mac/campana-3.webp', pie: '', destacada: true },
        { tipo: 'imagen', src: '/portafolio/mac/campana-1.webp', pie: '' },
        { tipo: 'imagen', src: '/portafolio/mac/campana-2.webp', pie: '' },
      ]},
    ],
